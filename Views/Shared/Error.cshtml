@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    Layout = "_Layout";
}

<div class="text-center py-5">
    <div class="mb-4">
        <i class="bi bi-exclamation-octagon display-1 text-danger" aria-hidden="true"></i>
    </div>
    <h1 class="display-5 mb-3">Something went wrong</h1>
    <p class="lead text-secondary mb-4">
        An error occurred while processing your request. Please try again later.
    </p>
    @if (Model.ShowRequestId)
    {
        <p class="text-secondary small">
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </p>
    }
    <div class="d-flex justify-content-center gap-3 flex-wrap mt-4">
        <a href="/" class="btn btn-portal btn-resident">
            <i class="bi bi-house me-1" aria-hidden="true"></i> Go Home
        </a>
        <button type="button" class="btn btn-outline-secondary" onclick="history.back()">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i> Go Back
        </button>
    </div>
</div>
