@model ComplaintDetailsViewModel
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    string Badge(string status) => status switch
    {
        "Initiated" => "text-bg-warning",
        "Approved" => "text-bg-primary",
        "Assigned" or "WorkInProgress" => "text-bg-info",
        "Resolved" => "text-bg-success",
        "Closed" => "text-bg-secondary",
        "Declined" => "text-bg-danger",
        "Cancelled" => "text-bg-dark",
        _ => "text-bg-light"
    };
}

<div class="page-header">
    <div>
        <h1 class="page-heading">Complaint #@Model.Uid</h1>
        <p class="page-subtitle">@Model.ResidentName @(string.IsNullOrWhiteSpace(Model.ResidentUnit) ? "" : $"(Unit {Model.ResidentUnit})")</p>
    </div>
    <a class="btn btn-outline-secondary" asp-area="@area" asp-controller="Complaints" asp-action="Index">Back to list</a>
</div>

@if (TempData["Success"] is string successMsg)
{
    <div class="alert alert-success" role="status">@successMsg</div>
}
@if (TempData["Error"] is string errorMsg)
{
    <div class="alert alert-danger" role="alert">@errorMsg</div>
}

<div class="row g-4">
    <div class="col-lg-7">
        <section class="card portal-card">
            <div class="card-body">
                <p>
                    <span class="badge @Badge(Model.Status)">@ComplaintStatus.Display(Model.Status)</span>
                    <span class="badge text-bg-light">@Model.Priority</span>
                    <span class="badge text-bg-light">@Model.CategoryName</span>
                    @if (Model.IsOverdue)
                    {
                        <span class="badge text-bg-danger">Overdue</span>
                    }
                </p>
                <dl class="profile-list">
                    <dt>Description</dt>
                    <dd style="white-space: pre-wrap;">@Model.Description</dd>
                    <dt>Contact</dt>
                    <dd>@(Model.ResidentMobile ?? "—") · @(Model.ResidentEmail ?? "no email")</dd>
                    <dt>Preferred visit</dt>
                    <dd>@(Model.PreferredVisitTime ?? "—")</dd>
                    <dt>Submitted</dt>
                    <dd>@TimeZone.FormatDateTime(Model.CreatedAtUtc)</dd>
                    @if (Model.SlaDueAtUtc is not null)
                    {
                        <dt>SLA due</dt>
                        <dd>@TimeZone.FormatDateTime(Model.SlaDueAtUtc)</dd>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.WorkerName))
                    {
                        <dt>Worker</dt>
                        <dd>@Model.WorkerName @(Model.WorkerPhone is null ? "" : $"· {Model.WorkerPhone}")</dd>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.DeclineReason))
                    {
                        <dt>Decline reason</dt>
                        <dd class="text-danger">@Model.DeclineReason</dd>
                    }
                </dl>

                <div class="d-flex flex-wrap gap-2 mt-3">
                    @if (Model.Status == ComplaintStatus.Initiated)
                    {
                        <form asp-area="@area" asp-controller="Complaints" asp-action="Approve" asp-route-id="@Model.Uid" method="post">
                            <button type="submit" class="btn btn-success btn-sm"
                                    data-confirm-title="Approve complaint?"
                                    data-confirm-text="Approve complaint #@Model.Uid?"
                                    data-confirm-ok="Approve">Approve</button>
                        </form>
                    }
                    @if (Model.Status is ComplaintStatus.Assigned)
                    {
                        <form asp-area="@area" asp-controller="Complaints" asp-action="StartWork" asp-route-id="@Model.Uid" method="post">
                            <button type="submit" class="btn btn-primary btn-sm"
                                    data-confirm-title="Start work?"
                                    data-confirm-ok="Start">Start work</button>
                        </form>
                    }
                    @if (Model.Status == ComplaintStatus.WorkInProgress)
                    {
                        <form asp-area="@area" asp-controller="Complaints" asp-action="Resolve" asp-route-id="@Model.Uid" method="post">
                            <button type="submit" class="btn btn-success btn-sm"
                                    data-confirm-title="Mark resolved?"
                                    data-confirm-ok="Resolve">Resolve</button>
                        </form>
                    }
                    @if (Model.Status is not (ComplaintStatus.Closed or ComplaintStatus.Cancelled))
                    {
                        <form asp-area="@area" asp-controller="Complaints" asp-action="Close" asp-route-id="@Model.Uid" method="post">
                            <button type="submit" class="btn btn-outline-secondary btn-sm"
                                    data-confirm-title="Close complaint?"
                                    data-confirm-ok="Close"
                                    data-confirm-icon="warning">Close</button>
                        </form>
                    }
                    @if (Model.Status is ComplaintStatus.Resolved or ComplaintStatus.Closed)
                    {
                        <form asp-area="@area" asp-controller="Complaints" asp-action="Reopen" asp-route-id="@Model.Uid" method="post">
                            <button type="submit" class="btn btn-outline-primary btn-sm"
                                    data-confirm-title="Reopen complaint?"
                                    data-confirm-ok="Reopen">Reopen</button>
                        </form>
                    }
                </div>

                @if (Model.Status == ComplaintStatus.Initiated)
                {
                    <form asp-area="@area" asp-controller="Complaints" asp-action="Decline" method="post" class="mt-3 border-top pt-3">
                        <input type="hidden" name="ComplaintId" value="@Model.Uid" />
                        <label class="form-label" for="decline-reason">Decline reason</label>
                        <textarea class="form-control" id="decline-reason" name="Reason" rows="2" required></textarea>
                        <button type="submit" class="btn btn-outline-danger btn-sm mt-2"
                                data-confirm-title="Decline complaint?"
                                data-confirm-ok="Decline"
                                data-confirm-icon="warning">Decline</button>
                    </form>
                }

                @if (Model.Status is ComplaintStatus.Approved or ComplaintStatus.Assigned or ComplaintStatus.Resolved or ComplaintStatus.Closed)
                {
                    <form asp-area="@area" asp-controller="Complaints" asp-action="Assign" method="post" class="mt-3 border-top pt-3">
                        <h3 class="h6">@(Model.Status == ComplaintStatus.Assigned ? "Reassign worker" : "Assign worker")</h3>
                        <input type="hidden" name="ComplaintId" value="@Model.Uid" />
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label" for="worker-name">Worker name</label>
                                <input class="form-control" id="worker-name" name="WorkerName" value="@Model.WorkerName" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="worker-phone">Worker phone (optional)</label>
                                <input class="form-control" id="worker-phone" name="WorkerPhone" value="@Model.WorkerPhone" />
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="assign-note">Note (optional)</label>
                                <input class="form-control" id="assign-note" name="Note" />
                            </div>
                        </div>
                        <button type="submit" class="btn btn-portal btn-sm mt-2"
                                data-confirm-title="Assign worker?"
                                data-confirm-ok="Assign">Save assignment</button>
                    </form>
                }

                <form asp-area="@area" asp-controller="Complaints" asp-action="AddNote" method="post" class="mt-3 border-top pt-3">
                    <h3 class="h6">Add note</h3>
                    <input type="hidden" name="ComplaintId" value="@Model.Uid" />
                    <textarea class="form-control" name="Note" rows="2" required></textarea>
                    <button type="submit" class="btn btn-outline-secondary btn-sm mt-2">Add note</button>
                </form>

                <partial name="_ComplaintPhotos" model="Model.Photos" />
            </div>
        </section>
    </div>
    <div class="col-lg-5">
        <section class="card portal-card">
            <div class="card-body">
                <partial name="_ComplaintTimeline" model="Model.History" />
            </div>
        </section>
    </div>
</div>
