@model ResidentProfileViewModel
@{
    ViewData["Title"] = "My Profile";
    string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
}

@{
    var emailForm = ViewBag.EmailForm as EditResidentEmailViewModel ?? new EditResidentEmailViewModel { Email = Model.Email };
}

<div class="page-header">
    <div>
        <h1 class="page-heading">My Profile</h1>
        <p class="page-subtitle">Your resident account details.</p>
    </div>
</div>

@if (TempData["Success"] is string successMsg)
{
    <div class="alert alert-success" role="status">@successMsg</div>
}

<div class="row g-4">
    <div class="col-lg-6">
        <section class="card portal-card">
            <div class="card-body">
                <h2 class="h5 mb-3">Personal Information</h2>
                <dl class="profile-list">
                    <dt>Name</dt>
                    <dd>@Model.ResidentName</dd>
                    <dt>Username</dt>
                    <dd>@Model.Username</dd>
                    <dt>Customer ID</dt>
                    <dd>@Display(Model.CustomerId)</dd>
                    <dt>Email</dt>
                    <dd>@Display(Model.Email)</dd>
                    <dt>Mobile</dt>
                    <dd>@Model.Mobile</dd>
                    <dt>Status</dt>
                    <dd>@(Model.IsActive ? "Active" : "Inactive")</dd>
                    <dt>Registered</dt>
                    <dd>@TimeZone.FormatDateTime(Model.CreatedAt, "dd MMM yyyy")</dd>
                </dl>

                <form asp-action="UpdateEmail" method="post" class="mt-3 border-top pt-3" novalidate>
                    <label class="form-label" for="Email">Update email</label>
                    <input class="form-control" id="Email" name="Email" type="email" value="@emailForm.Email" maxlength="256" />
                    <div asp-validation-summary="ModelOnly" class="text-danger small mt-1"></div>
                    <button type="submit" class="btn btn-portal btn-resident btn-sm mt-2">Save email</button>
                </form>
            </div>
        </section>
    </div>
    <div class="col-lg-6">
        <section class="card portal-card">
            <div class="card-body">
                <h2 class="h5 mb-3">Property / Unit Details</h2>
                <dl class="profile-list">
                    <dt>Unit No</dt>
                    <dd>@Display(Model.UnitNo)</dd>
                    <dt>Street</dt>
                    <dd>@Display(Model.Street)</dd>
                    <dt>Tower</dt>
                    <dd>@Display(Model.Tower)</dd>
                    <dt>Floor</dt>
                    <dd>@Display(Model.Floor)</dd>
                    <dt>Block</dt>
                    <dd>@Display(Model.Block)</dd>
                </dl>
            </div>
        </section>
    </div>
</div>
