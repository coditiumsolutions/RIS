@{
    ViewData["Title"] = "Home";
}

<section class="home-hero mb-4">
    <div class="home-hero-copy">
        <h1 class="page-heading">RIS</h1>
        <p class="page-subtitle">Access your community services from one convenient place.</p>
    </div>
</section>

<div class="project-card-grid">
    <a class="project-card project-card-primary card-tone-1" asp-area="" asp-controller="Visitors" asp-action="Index">
        <div class="project-card-icon visitors" aria-hidden="true">
            <i class="bi bi-people-fill"></i>
        </div>
        <div class="project-card-copy">
            <h2 class="project-card-title">Visitor Management</h2>
            <p class="project-card-subtitle">Register and track visitors</p>
        </div>
    </a>

    <div class="project-card project-card-disabled card-tone-2" aria-disabled="true">
        <span class="coming-soon-badge">Coming soon</span>
        <div class="project-card-icon gatepass" aria-hidden="true">
            <i class="bi bi-door-open-fill"></i>
        </div>
        <div class="project-card-copy">
            <h2 class="project-card-title">Gate Pass</h2>
            <p class="project-card-subtitle">Request residential gate passes</p>
        </div>
    </div>

    <div class="project-card project-card-disabled card-tone-3" aria-disabled="true">
        <span class="coming-soon-badge">Coming soon</span>
        <div class="project-card-icon statement" aria-hidden="true">
            <i class="bi bi-file-earmark-text-fill"></i>
        </div>
        <div class="project-card-copy">
            <h2 class="project-card-title">Account Statement</h2>
            <p class="project-card-subtitle">View account history</p>
        </div>
    </div>

    <div class="project-card project-card-disabled card-tone-4" aria-disabled="true">
        <span class="coming-soon-badge">Coming soon</span>
        <div class="project-card-icon bills" aria-hidden="true">
            <i class="bi bi-receipt"></i>
        </div>
        <div class="project-card-copy">
            <h2 class="project-card-title">Bill Management</h2>
            <p class="project-card-subtitle">Review society bills</p>
        </div>
    </div>

    <div class="project-card project-card-disabled card-tone-5" aria-disabled="true">
        <span class="coming-soon-badge">Coming soon</span>
        <div class="project-card-icon electricity" aria-hidden="true">
            <i class="bi bi-lightning-charge-fill"></i>
        </div>
        <div class="project-card-copy">
            <h2 class="project-card-title">Electricity</h2>
            <p class="project-card-subtitle">Meters and electricity bills</p>
        </div>
    </div>

    <div class="project-card project-card-disabled card-tone-6" aria-disabled="true">
        <span class="coming-soon-badge">Coming soon</span>
        <div class="project-card-icon utility" aria-hidden="true">
            <i class="bi bi-building-gear"></i>
        </div>
        <div class="project-card-copy">
            <h2 class="project-card-title">Utilities</h2>
            <p class="project-card-subtitle">Maintenance and utilities</p>
        </div>
    </div>

    <div class="project-card project-card-disabled card-tone-7" aria-disabled="true">
        <span class="coming-soon-badge">Coming soon</span>
        <div class="project-card-icon complaints" aria-hidden="true">
            <i class="bi bi-headset"></i>
        </div>
        <div class="project-card-copy">
            <h2 class="project-card-title">Complaints</h2>
            <p class="project-card-subtitle">Submit and track issues</p>
        </div>
    </div>

    <div class="project-card project-card-disabled card-tone-8" aria-disabled="true">
        <span class="coming-soon-badge">Coming soon</span>
        <div class="project-card-icon notifications" aria-hidden="true">
            <i class="bi bi-bell-fill"></i>
        </div>
        <div class="project-card-copy">
            <h2 class="project-card-title">Notifications</h2>
            <p class="project-card-subtitle">Society announcements</p>
        </div>
    </div>
</div>
