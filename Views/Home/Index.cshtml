@{
    ViewData["Title"] = "Home";
}

<section class="home-hero mb-4">
    <div class="home-hero-copy">
        <h1 class="page-heading">RIS</h1>
        <p class="page-subtitle">Access your community services from one convenient place.</p>
    </div>
</section>

<div class="row g-3 g-md-4 project-card-grid">
    <div class="col-6 col-md-4 col-xl-3">
        <a class="project-card" asp-area="" asp-controller="Visitors" asp-action="Index">
            <div class="project-card-icon visitors" aria-hidden="true">
                <i class="bi bi-people-fill"></i>
            </div>
            <h2 class="project-card-title">Visitor Management</h2>
        </a>
    </div>

    <div class="col-6 col-md-4 col-xl-3">
        <div class="project-card project-card-disabled" aria-disabled="true">
            <span class="coming-soon-badge">Coming soon</span>
            <div class="project-card-icon gatepass" aria-hidden="true">
                <i class="bi bi-door-open-fill"></i>
            </div>
            <h2 class="project-card-title">Gate Pass</h2>
        </div>
    </div>

    <div class="col-6 col-md-4 col-xl-3">
        <div class="project-card project-card-disabled" aria-disabled="true">
            <span class="coming-soon-badge">Coming soon</span>
            <div class="project-card-icon statement" aria-hidden="true">
                <i class="bi bi-file-earmark-text-fill"></i>
            </div>
            <h2 class="project-card-title">Account Statement</h2>
        </div>
    </div>

    <div class="col-6 col-md-4 col-xl-3">
        <div class="project-card project-card-disabled" aria-disabled="true">
            <span class="coming-soon-badge">Coming soon</span>
            <div class="project-card-icon bills" aria-hidden="true">
                <i class="bi bi-receipt"></i>
            </div>
            <h2 class="project-card-title">Bill Management</h2>
        </div>
    </div>

    <div class="col-6 col-md-4 col-xl-3">
        <div class="project-card project-card-disabled" aria-disabled="true">
            <span class="coming-soon-badge">Coming soon</span>
            <div class="project-card-icon electricity" aria-hidden="true">
                <i class="bi bi-lightning-charge-fill"></i>
            </div>
            <h2 class="project-card-title">Electricity Management</h2>
        </div>
    </div>

    <div class="col-6 col-md-4 col-xl-3">
        <div class="project-card project-card-disabled" aria-disabled="true">
            <span class="coming-soon-badge">Coming soon</span>
            <div class="project-card-icon utility" aria-hidden="true">
                <i class="bi bi-building-gear"></i>
            </div>
            <h2 class="project-card-title">Utility Management</h2>
        </div>
    </div>

    <div class="col-6 col-md-4 col-xl-3">
        <div class="project-card project-card-disabled" aria-disabled="true">
            <span class="coming-soon-badge">Coming soon</span>
            <div class="project-card-icon complaints" aria-hidden="true">
                <i class="bi bi-headset"></i>
            </div>
            <h2 class="project-card-title">Complaints Management</h2>
        </div>
    </div>

    <div class="col-6 col-md-4 col-xl-3">
        <div class="project-card project-card-disabled" aria-disabled="true">
            <span class="coming-soon-badge">Coming soon</span>
            <div class="project-card-icon notifications" aria-hidden="true">
                <i class="bi bi-bell-fill"></i>
            </div>
            <h2 class="project-card-title">Society Notifications</h2>
        </div>
    </div>
</div>
