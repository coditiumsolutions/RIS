@{
    ViewData["Title"] = "Home";
}

<section class="home-hero mb-4">
    <div class="home-hero-copy">
        <h1 class="page-heading">Resident Portal Management System</h1>
        <p class="page-subtitle">Access your community services from one convenient place.</p>
    </div>
</section>

<div class="row g-4 project-card-grid">
    <div class="col-12 col-md-6 col-lg-4">
        <a class="project-card" asp-area="" asp-controller="Electricity" asp-action="Index">
            <span class="project-card-accent" aria-hidden="true"></span>
            <div class="project-card-icon electricity" aria-hidden="true">
                <i class="bi bi-lightning-charge-fill"></i>
            </div>
            <h2 class="project-card-title">Electricity Management</h2>
            <p class="project-card-text">View electricity bills, payment details, meter information, and billing history.</p>
            <span class="btn btn-portal btn-resident project-card-btn">Open Electricity Management</span>
        </a>
    </div>

    <div class="col-12 col-md-6 col-lg-4">
        <a class="project-card" asp-area="" asp-controller="Utility" asp-action="Index">
            <span class="project-card-accent" aria-hidden="true"></span>
            <div class="project-card-icon utility" aria-hidden="true">
                <i class="bi bi-building-gear"></i>
            </div>
            <h2 class="project-card-title">Utility Management</h2>
            <p class="project-card-text">Manage utility services, maintenance charges, bills, payments, and account details.</p>
            <span class="btn btn-portal btn-resident project-card-btn">Open Utility Management</span>
        </a>
    </div>

    <div class="col-12 col-md-6 col-lg-4">
        <a class="project-card" asp-area="" asp-controller="Visitors" asp-action="Index">
            <span class="project-card-accent" aria-hidden="true"></span>
            <div class="project-card-icon visitors" aria-hidden="true">
                <i class="bi bi-people-fill"></i>
            </div>
            <h2 class="project-card-title">Visitors Portal</h2>
            <p class="project-card-text">Submit visitor requests, review approvals, and view visitor entry information.</p>
            <span class="btn btn-portal btn-resident project-card-btn">Open Visitors Portal</span>
        </a>
    </div>

    <div class="col-12 col-md-6 col-lg-4">
        <a class="project-card" asp-area="" asp-controller="Complaints" asp-action="Index">
            <span class="project-card-accent" aria-hidden="true"></span>
            <div class="project-card-icon complaints" aria-hidden="true">
                <i class="bi bi-headset"></i>
            </div>
            <h2 class="project-card-title">Complaints Management</h2>
            <p class="project-card-text">Submit complaints, track their status, and review previous complaints.</p>
            <span class="btn btn-portal btn-resident project-card-btn">Open Complaints</span>
        </a>
    </div>

    <div class="col-12 col-md-6 col-lg-4">
        <a class="project-card" asp-area="" asp-controller="Notifications" asp-action="Index">
            <span class="project-card-accent" aria-hidden="true"></span>
            <div class="project-card-icon notifications" aria-hidden="true">
                <i class="bi bi-bell-fill"></i>
            </div>
            <h2 class="project-card-title">Society Notifications</h2>
            <p class="project-card-text">View society announcements, important notices, maintenance updates, and community alerts.</p>
            <span class="btn btn-portal btn-resident project-card-btn">View Notifications</span>
        </a>
    </div>
</div>
