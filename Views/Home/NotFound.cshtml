@{
    ViewData["Title"] = "Page Not Found";
    Layout = ViewData["LayoutOverride"] as string ?? "~/Views/Shared/_StatusLayout.cshtml";
}

<div class="text-center py-5">
    <div class="mb-4">
        <i class="bi bi-exclamation-triangle display-1 text-warning" aria-hidden="true"></i>
    </div>
    <h1 class="display-5 mb-3">Page Not Found</h1>
    <p class="lead text-secondary mb-4">
        The page you're looking for doesn't exist or has been moved.
    </p>
    <div class="d-flex justify-content-center gap-3 flex-wrap">
        <a href="/" class="btn btn-portal btn-resident">
            <i class="bi bi-house me-1" aria-hidden="true"></i> Go Home
        </a>
        <button type="button" class="btn btn-outline-secondary" data-history-back>
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i> Go Back
        </button>
    </div>
</div>
