@model LoginViewModel
@{
    ViewData["Title"] = "Resident Login";
    Layout = "_LoginLayout";
}

<div class="login-stage">
    <aside class="login-hero" aria-label="Welcome">
        <div>
            <div class="login-hero-brand">
                <div class="brand-mark" aria-hidden="true"><i class="bi bi-buildings"></i></div>
                <div>
                    <strong>Resident Portal Management System</strong>
                    <span>Community access</span>
                </div>
            </div>
            <h2>Welcome to your residential community portal</h2>
            <p>Sign in securely to review your profile, visitor activity, and community services from one place.</p>
        </div>
        <div class="login-hero-art" aria-hidden="true">
            <div class="login-hero-tile"><i class="bi bi-house-heart"></i><span>Home</span></div>
            <div class="login-hero-tile"><i class="bi bi-people"></i><span>Visitors</span></div>
            <div class="login-hero-tile"><i class="bi bi-shield-check"></i><span>Secure</span></div>
        </div>
    </aside>

    <section class="login-panel">
        <div class="login-card">
            <p class="login-kicker">Resident Portal</p>
            <h1>Sign in</h1>
            <p class="login-lead">Enter your resident username and password to continue.</p>
            @if (Context.Request.Query.ContainsKey("sessionExpired"))
            {
                <div class="alert alert-warning" role="alert">
                    <i class="bi bi-exclamation-triangle me-2" aria-hidden="true"></i>
                    Your session expired, please try again.
                </div>
            }
            @if (Context.Request.Query.ContainsKey("rateLimited"))
            {
                <div class="alert alert-warning" role="alert">
                    <i class="bi bi-exclamation-triangle me-2" aria-hidden="true"></i>
                    Too many login attempts. Please try again later.
                </div>
            }
            <form asp-controller="Home" asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="Username" class="form-label"></label>
                    <div class="input-icon-group">
                        <i class="bi bi-person" aria-hidden="true"></i>
                        <input asp-for="Username" class="form-control" autocomplete="username" autofocus />
                    </div>
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Password" class="form-label"></label>
                    <div class="input-icon-group has-toggle">
                        <i class="bi bi-lock" aria-hidden="true"></i>
                        <input asp-for="Password" class="form-control" autocomplete="current-password" />
                        <button type="button" class="password-toggle" data-password-toggle="Password" aria-label="Show password" aria-pressed="false">
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                <button type="submit" class="btn btn-portal btn-resident w-100">Login</button>
            </form>
            <partial name="_DemoLoginFill" model='"Resident"' />
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
