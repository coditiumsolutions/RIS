@model ResidentVisitorListViewModel
@{
    ViewData["Title"] = "Visitor Management";
    string Badge(string status) => status switch
    {
        "CheckedIn" => "text-bg-success",
        "CheckedOut" => "text-bg-secondary",
        "Approved" => "text-bg-primary",
        "Pending" => "text-bg-warning",
        "Declined" => "text-bg-danger",
        "Cancelled" => "text-bg-dark",
        _ => "text-bg-light"
    };
    string StatusLabel(string status) => status switch
    {
        "CheckedIn" => "Checked In",
        "CheckedOut" => "Checked Out",
        _ => status
    };
}

<div class="page-header">
    <div>
        <h1 class="page-heading">Visitor Management</h1>
        <p class="page-subtitle">Pre-register visitors and track their status.</p>
    </div>
    <a class="btn btn-portal btn-resident" asp-area="" asp-controller="Visitors" asp-action="Register">
        <i class="bi bi-person-plus me-1" aria-hidden="true"></i> Register Visitor
    </a>
</div>

@if (TempData["Success"] is string successMsg)
{
    <div class="alert alert-success" role="status">@successMsg</div>
}
@if (TempData["Error"] is string errorMsg)
{
    <div class="alert alert-danger" role="alert">@errorMsg</div>
}

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card portal-card stat-card">
            <div class="card-body">
                <p class="stat-label">Total</p>
                <p class="stat-value">@Model.TotalCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card portal-card stat-card">
            <div class="card-body">
                <p class="stat-label">Pending</p>
                <p class="stat-value">@Model.PendingCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card portal-card stat-card">
            <div class="card-body">
                <p class="stat-label">Approved</p>
                <p class="stat-value">@Model.ApprovedCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card portal-card stat-card">
            <div class="card-body">
                <p class="stat-label">Checked In</p>
                <p class="stat-value">@Model.CheckedInCount</p>
            </div>
        </div>
    </div>
</div>

<section class="card portal-card">
    <div class="card-body">
        @if (Model.Visitors.Any())
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th scope="col">Visitor</th>
                            <th scope="col">Phone</th>
                            <th scope="col">Arrival</th>
                            <th scope="col">Guests</th>
                            <th scope="col">Status</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var visitor in Model.Visitors)
                        {
                            <tr>
                                <td>
                                    <a asp-area="" asp-controller="Visitors" asp-action="Details" asp-route-id="@visitor.Uid">
                                        @visitor.VisitorName
                                    </a>
                                    @if (visitor.IsWalkIn)
                                    {
                                        <span class="badge text-bg-info ms-1">Walk-in</span>
                                    }
                                </td>
                                <td>@visitor.Phone</td>
                                <td>@visitor.ArrivalDate.ToString("dd MMM yyyy", CultureInfo.InvariantCulture)</td>
                                <td>@visitor.NumberOfGuests</td>
                                <td><span class="badge @Badge(visitor.Status)">@StatusLabel(visitor.Status)</span></td>
                                <td>
                                    <a asp-area="" asp-controller="Visitors" asp-action="Details" asp-route-id="@visitor.Uid" class="btn btn-sm btn-outline-secondary">Details</a>
                                    @if (visitor.Status == "Pending" || visitor.Status == "Approved")
                                    {
                                        <form asp-area="" asp-controller="Visitors" asp-action="Cancel" asp-route-id="@visitor.Uid" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to cancel this visitor?')">Cancel</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-4">
                <i class="bi bi-people display-4 text-secondary" aria-hidden="true"></i>
                <p class="text-secondary mt-3 mb-0">No visitors registered yet.</p>
                <a class="btn btn-portal btn-resident mt-3" asp-area="" asp-controller="Visitors" asp-action="Register">
                    <i class="bi bi-person-plus me-1" aria-hidden="true"></i> Register Your First Visitor
                </a>
            </div>
        }
    </div>
</section>
