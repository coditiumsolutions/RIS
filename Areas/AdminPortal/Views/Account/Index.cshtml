@model LoginViewModel
@{
    ViewData["Title"] = "Admin Login";
    Layout = "_AdminLoginLayout";
}

<div class="login-stage">
    <aside class="login-hero" aria-label="Administration welcome">
        <div>
            <div class="login-hero-brand">
                <div class="brand-mark" aria-hidden="true"><i class="bi bi-shield-lock"></i></div>
                <div>
                    <strong>Resident Portal Management System</strong>
                    <span>Operations console</span>
                </div>
            </div>
            <h2>Secure access for community administrators</h2>
            <p>Use the administration portal to manage residents, visitors, and portal users with role-based controls.</p>
        </div>
        <div class="login-hero-art" aria-hidden="true">
            <div class="login-hero-tile"><i class="bi bi-people-fill"></i><span>Residents</span></div>
            <div class="login-hero-tile"><i class="bi bi-person-badge"></i><span>Visitors</span></div>
            <div class="login-hero-tile"><i class="bi bi-gear"></i><span>Users</span></div>
        </div>
    </aside>

    <section class="login-panel">
        <div class="login-card">
            <p class="login-kicker">Administration Portal</p>
            <h1>Administrator sign in</h1>
            <p class="login-lead">This entrance is reserved for authorized portal administrators.</p>
            @if (Context.Request.Query.ContainsKey("sessionExpired"))
            {
                <div class="alert alert-warning" role="alert">
                    <i class="bi bi-exclamation-triangle me-2" aria-hidden="true"></i>
                    Your session expired, please try again.
                </div>
            }
            @if (Context.Request.Query.ContainsKey("rateLimited"))
            {
                <div class="alert alert-warning" role="alert">
                    <i class="bi bi-exclamation-triangle me-2" aria-hidden="true"></i>
                    Too many login attempts. Please try again later.
                </div>
            }
            <form asp-area="AdminPortal" asp-controller="Account" asp-action="Index" method="post">
                <div asp-validation-summary="ModelOnly" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="Username" class="form-label"></label>
                    <div class="input-icon-group">
                        <i class="bi bi-person-gear" aria-hidden="true"></i>
                        <input asp-for="Username" class="form-control" autocomplete="username" autofocus />
                    </div>
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Password" class="form-label"></label>
                    <div class="input-icon-group has-toggle">
                        <i class="bi bi-lock-fill" aria-hidden="true"></i>
                        <input asp-for="Password" class="form-control" autocomplete="current-password" />
                        <button type="button" class="password-toggle" data-password-toggle="Password" aria-label="Show password" aria-pressed="false">
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                <button type="submit" class="btn btn-portal btn-admin w-100">Login</button>
            </form>
            <partial name="_DemoLoginFill" model='"Admin"' />
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
