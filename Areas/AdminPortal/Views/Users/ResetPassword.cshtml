@model ResetUserPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="page-header">
    <div>
        <h1 class="page-heading">Reset Password</h1>
        <p class="page-subtitle">@Model.UserName (@Model.UserType)</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-6">
        <section class="card portal-card">
            <div class="card-body">
                <div class="alert alert-info mb-4">
                    <i class="bi bi-info-circle me-1" aria-hidden="true"></i>
                    This will reset the password for <strong>@Model.UserName</strong>. They will need to use this new password to log in.
                </div>

                <form asp-area="AdminPortal" asp-controller="Users" asp-action="ResetReceptionistPassword" method="post" novalidate>
                    <input type="hidden" asp-for="Uid" />
                    <input type="hidden" asp-for="UserName" />
                    <input type="hidden" asp-for="UserType" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label"></label>
                        <input asp-for="NewPassword" class="form-control" autocomplete="new-password" autofocus />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        <div class="form-text">Minimum 8 characters.</div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <div class="form-check">
                            <input asp-for="MustChangePassword" class="form-check-input" type="checkbox" />
                            <label asp-for="MustChangePassword" class="form-check-label"></label>
                        </div>
                    </div>
                    <div>
                        <button type="submit"
                                class="btn btn-portal btn-admin"
                                data-confirm-title="Reset password?"
                                data-confirm-text="Reset the password for @Model.UserName?"
                                data-confirm-ok="Reset Password"
                                data-confirm-cancel="Cancel"
                                data-confirm-icon="warning">
                            <i class="bi bi-key me-1" aria-hidden="true"></i> Reset Password
                        </button>
                        <a asp-area="AdminPortal" asp-controller="Users" asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
                    </div>
                </form>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
