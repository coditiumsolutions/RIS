@model EditResidentViewModel
@{
    ViewData["Title"] = "Edit Resident";
}

<div class="page-header">
    <div>
        <h1 class="page-heading">Edit Resident</h1>
        <p class="page-subtitle">@Model.ResidentName</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <section class="card portal-card">
            <div class="card-body">
                <form asp-area="AdminPortal" asp-controller="Residents" asp-action="Edit" method="post" novalidate>
                    <input type="hidden" asp-for="Uid" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <h2 class="h6 text-secondary mb-3">Account Information</h2>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="ResidentName" class="form-label"></label>
                            <input asp-for="ResidentName" class="form-control" />
                            <span asp-validation-for="ResidentName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Username" class="form-label"></label>
                            <input asp-for="Username" class="form-control" />
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" type="email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check mt-4">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                                <label asp-for="IsActive" class="form-check-label"></label>
                            </div>
                        </div>
                    </div>

                    <h2 class="h6 text-secondary mb-3 mt-4">Contact Information</h2>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Mobile" class="form-label"></label>
                            <input asp-for="Mobile" class="form-control" type="tel" />
                            <span asp-validation-for="Mobile" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Mobile2" class="form-label"></label>
                            <input asp-for="Mobile2" class="form-control" type="tel" />
                            <span asp-validation-for="Mobile2" class="text-danger small"></span>
                        </div>
                    </div>

                    <h2 class="h6 text-secondary mb-3 mt-4">Residence Details</h2>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="UnitNo" class="form-label"></label>
                            <input asp-for="UnitNo" class="form-control" />
                            <span asp-validation-for="UnitNo" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Tower" class="form-label"></label>
                            <input asp-for="Tower" class="form-control" />
                            <span asp-validation-for="Tower" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Block" class="form-label"></label>
                            <input asp-for="Block" class="form-control" />
                            <span asp-validation-for="Block" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Floor" class="form-label"></label>
                            <input asp-for="Floor" class="form-control" />
                            <span asp-validation-for="Floor" class="text-danger small"></span>
                        </div>
                        <div class="col-md-8">
                            <label asp-for="Street" class="form-label"></label>
                            <input asp-for="Street" class="form-control" />
                            <span asp-validation-for="Street" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Status" class="form-label"></label>
                            <select asp-for="Status" class="form-select" asp-items="@(new SelectList(ResidentStatuses.All))">
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-portal btn-admin">
                            <i class="bi bi-check-circle me-1" aria-hidden="true"></i> Save Changes
                        </button>
                        <a asp-area="AdminPortal" asp-controller="Residents" asp-action="ResetPassword" asp-route-id="@Model.Uid" class="btn btn-outline-secondary ms-2">Reset Password</a>
                        <a asp-area="AdminPortal" asp-controller="Residents" asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
                    </div>
                </form>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
