@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-header">
    <div>
        <h1 class="page-heading">Welcome, @Model.AdminName</h1>
        <p class="page-subtitle">Administration overview from live portal data.</p>
    </div>
</div>

@if (TempData[ChangePasswordViewModel.SuccessMessageKey] is string passwordChanged)
{
    <div class="alert alert-success" role="status">@passwordChanged</div>
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <section class="card portal-card stat-card">
            <div class="card-body">
                <div class="stat-icon" aria-hidden="true"><i class="bi bi-houses"></i></div>
                <p class="stat-label">Registered residents</p>
                <p class="stat-value">@Model.ResidentCount</p>
            </div>
        </section>
    </div>
    <div class="col-md-4">
        <section class="card portal-card stat-card">
            <div class="card-body">
                <div class="stat-icon" aria-hidden="true"><i class="bi bi-person-badge"></i></div>
                <p class="stat-label">Visitors today</p>
                <p class="stat-value">@Model.VisitorsTodayCount</p>
            </div>
        </section>
    </div>
    <div class="col-md-4">
        <section class="card portal-card stat-card">
            <div class="card-body">
                <div class="stat-icon" aria-hidden="true"><i class="bi bi-people"></i></div>
                <p class="stat-label">Portal users</p>
                <p class="stat-value">@Model.PortalUserCount</p>
            </div>
        </section>
    </div>
</div>

<h2 class="h5 mb-3" style="color: var(--rp-primary); font-weight: 700;">Modules</h2>
<div class="shortcut-grid mb-4">
    <a class="shortcut-link" asp-area="AdminPortal" asp-controller="Visitors" asp-action="Index">
        <strong><i class="bi bi-person-badge me-1" aria-hidden="true"></i> Visitor Management</strong>
        <span class="d-block text-secondary mt-1">Review, approve, and decline visitor requests.</span>
    </a>
    <a class="shortcut-link" asp-area="AdminPortal" asp-controller="Residents" asp-action="Index">
        <strong><i class="bi bi-houses me-1" aria-hidden="true"></i> Resident Management</strong>
        <span class="d-block text-secondary mt-1">Create, edit, and search resident accounts.</span>
    </a>
    <a class="shortcut-link" asp-area="AdminPortal" asp-controller="Users" asp-action="Index">
        <strong><i class="bi bi-people me-1" aria-hidden="true"></i> User Management</strong>
        <span class="d-block text-secondary mt-1">Manage receptionist accounts and portal users.</span>
    </a>
    <div class="shortcut-link shortcut-link-disabled" aria-disabled="true">
        <span class="coming-soon-badge">Coming soon</span>
        <strong><i class="bi bi-door-open me-1" aria-hidden="true"></i> Gate Pass</strong>
        <span class="d-block text-secondary mt-1">Issue and track residential gate passes.</span>
    </div>
    <div class="shortcut-link shortcut-link-disabled" aria-disabled="true">
        <span class="coming-soon-badge">Coming soon</span>
        <strong><i class="bi bi-file-earmark-text me-1" aria-hidden="true"></i> Account Statement</strong>
        <span class="d-block text-secondary mt-1">Review resident account statements.</span>
    </div>
    <div class="shortcut-link shortcut-link-disabled" aria-disabled="true">
        <span class="coming-soon-badge">Coming soon</span>
        <strong><i class="bi bi-receipt me-1" aria-hidden="true"></i> Bill Management</strong>
        <span class="d-block text-secondary mt-1">Manage society billing and invoices.</span>
    </div>
</div>

<section class="card portal-card">
    <div class="card-body">
        <h2 class="h5">Recent activity</h2>
        @if (Model.RecentActivity.Any())
        {
            <ul class="list-group list-group-flush mt-3">
                @foreach (var item in Model.RecentActivity)
                {
                    <li class="list-group-item px-0">
                        <div class="d-flex justify-content-between gap-3">
                            <div>
                                <strong>@item.Title</strong>
                                <div class="text-secondary">@item.Detail</div>
                            </div>
                            <time class="text-secondary text-nowrap">@TimeZone.FormatDateTime(item.When, "dd MMM, HH:mm")</time>
                        </div>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="text-secondary mb-0 mt-3">No recent activity recorded.</p>
        }
    </div>
</section>
