@model VisitorDetailsViewModel
@{
    ViewData["Title"] = "Visitor Details";
    string Badge(string status) => status switch
    {
        "CheckedIn" => "text-bg-success",
        "CheckedOut" => "text-bg-secondary",
        "Approved" => "text-bg-primary",
        "Pending" => "text-bg-warning",
        "Declined" => "text-bg-danger",
        "Cancelled" => "text-bg-dark",
        _ => "text-bg-light"
    };
    string StatusLabel(string status) => status switch
    {
        "CheckedIn" => "Checked In",
        "CheckedOut" => "Checked Out",
        _ => status
    };
}

<div class="page-header">
    <div>
        <h1 class="page-heading">Visitor Details</h1>
        <p class="page-subtitle">
            @Model.VisitorName
            @if (Model.IsWalkIn)
            {
                <span class="badge text-bg-info ms-1">Walk-in</span>
            }
        </p>
    </div>
    <a asp-area="AdminPortal" asp-controller="Visitors" asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1" aria-hidden="true"></i> Back to List
    </a>
</div>

@if (TempData["Success"] is string successMsg)
{
    <div class="alert alert-success" role="status">@successMsg</div>
}
@if (TempData["Error"] is string errorMsg)
{
    <div class="alert alert-danger" role="alert">@errorMsg</div>
}

<div class="row g-3 g-lg-4 details-layout">
    <div class="col-lg-6">
        <section class="card portal-card">
            <div class="card-body">
                <h2 class="h5 mb-3">Visitor Information</h2>
                <dl class="profile-list">
                    <dt>Name</dt>
                    <dd>@Model.VisitorName</dd>
                    <dt>Phone</dt>
                    <dd>@Model.Phone</dd>
                    <dt>Purpose</dt>
                    <dd>@Model.Purpose</dd>
                    <dt>Duration</dt>
                    <dd>@Model.Duration</dd>
                    <dt>Arrival Date</dt>
                    <dd>@Model.ArrivalDate.ToString("dd MMM yyyy", CultureInfo.InvariantCulture)</dd>
                    <dt>Number of Guests</dt>
                    <dd>@Model.NumberOfGuests</dd>
                    @if (!string.IsNullOrWhiteSpace(Model.CNIC))
                    {
                        <dt>CNIC</dt>
                        <dd>@Model.CNIC</dd>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.VehicleRegistrationNo))
                    {
                        <dt>Vehicle</dt>
                        <dd>@Model.VehicleRegistrationNo</dd>
                    }
                </dl>
            </div>
        </section>
    </div>

    <div class="col-lg-6">
        <div class="details-stack">
            <section class="card portal-card">
                <div class="card-body">
                    <h2 class="h5 mb-3">Resident Information</h2>
                    <dl class="profile-list">
                        <dt>Resident</dt>
                        <dd>@Model.ResidentName</dd>
                        @if (!string.IsNullOrWhiteSpace(Model.ResidentUnit))
                        {
                            <dt>Unit</dt>
                            <dd>@Model.ResidentUnit</dd>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.ResidentMobile))
                        {
                            <dt>Mobile</dt>
                            <dd>@Model.ResidentMobile</dd>
                        }
                    </dl>
                </div>
            </section>

            <section class="card portal-card">
                <div class="card-body">
                    <h2 class="h5 mb-3">Status</h2>
                <p class="mb-3">
                    <span class="badge @Badge(Model.Status) fs-6">@StatusLabel(Model.Status)</span>
                    @if (Model.IsWalkIn)
                    {
                        <span class="badge text-bg-info ms-1">Walk-in Visitor</span>
                    }
                </p>
                <dl class="profile-list">
                    <dt>Registered</dt>
                    <dd>@TimeZone.FormatDateTime(Model.CreatedAt)</dd>
                    @if (Model.CheckedInAt.HasValue)
                    {
                        <dt>Checked In</dt>
                        <dd>@TimeZone.FormatDateTime(Model.CheckedInAt)</dd>
                    }
                    @if (Model.CheckedOutAt.HasValue)
                    {
                        <dt>Checked Out</dt>
                        <dd>@TimeZone.FormatDateTime(Model.CheckedOutAt)</dd>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.DeclineReason))
                    {
                        <dt>Decline Reason</dt>
                        <dd class="text-danger">@Model.DeclineReason</dd>
                    }
                </dl>

                @if (Model.Status == "Pending")
                {
                    <div class="mt-3 d-flex gap-2">
                        <form asp-area="AdminPortal" asp-controller="Visitors" asp-action="Approve" asp-route-id="@Model.Uid" method="post">
                            <button type="submit"
                                    class="btn btn-success"
                                    data-confirm-title="Approve visitor?"
                                    data-confirm-text="Approve @Model.VisitorName for arrival on @Model.ArrivalDate.ToString("dd MMM yyyy", CultureInfo.InvariantCulture)?"
                                    data-confirm-ok="Approve"
                                    data-confirm-cancel="Cancel">
                                <i class="bi bi-check-circle me-1" aria-hidden="true"></i> Approve
                            </button>
                        </form>
                        <a asp-area="AdminPortal" asp-controller="Visitors" asp-action="Decline" asp-route-id="@Model.Uid" class="btn btn-outline-danger">
                            <i class="bi bi-x-circle me-1" aria-hidden="true"></i> Decline
                        </a>
                    </div>
                }

                <partial name="_VisitorPhotoGallery" model="Model.Photos" />
            </div>
        </section>
        </div>
    </div>
</div>
