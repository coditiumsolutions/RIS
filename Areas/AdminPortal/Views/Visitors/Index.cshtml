@model AdminVisitorListViewModel
@{
    ViewData["Title"] = "Visitor Management";
    string Badge(string status) => status switch
    {
        "CheckedIn" => "text-bg-success",
        "CheckedOut" => "text-bg-secondary",
        "Approved" => "text-bg-primary",
        "Pending" => "text-bg-warning",
        "Declined" => "text-bg-danger",
        "Cancelled" => "text-bg-dark",
        _ => "text-bg-light"
    };
    string StatusLabel(string status) => status switch
    {
        "CheckedIn" => "Checked In",
        "CheckedOut" => "Checked Out",
        _ => status
    };
}

<div class="page-header">
    <div>
        <h1 class="page-heading">Visitor Management</h1>
        <p class="page-subtitle">View and manage visitor requests from residents.</p>
    </div>
</div>

@if (TempData["Success"] is string successMsg)
{
    <div class="alert alert-success" role="status">@successMsg</div>
}
@if (TempData["Error"] is string errorMsg)
{
    <div class="alert alert-danger" role="alert">@errorMsg</div>
}

@if (!Model.ApprovalRequired)
{
    <div class="alert alert-info mb-4">
        <i class="bi bi-info-circle me-1" aria-hidden="true"></i>
        Visitor approval is currently <strong>auto-approved</strong>. Visitors registered by residents are automatically approved.
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card portal-card stat-card">
            <div class="card-body">
                <p class="stat-label">Total</p>
                <p class="stat-value">@Model.TotalCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card portal-card stat-card">
            <div class="card-body">
                <p class="stat-label">Pending approval</p>
                <p class="stat-value">@Model.PendingCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card portal-card stat-card">
            <div class="card-body">
                <p class="stat-label">Approved today</p>
                <p class="stat-value">@Model.ApprovedTodayCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card portal-card stat-card">
            <div class="card-body">
                <p class="stat-label">Currently checked in</p>
                <p class="stat-value">@Model.CheckedInCount</p>
            </div>
        </div>
    </div>
</div>

<section class="card portal-card">
    <div class="card-body">
        <form method="get" class="row g-3 mb-4">
            <div class="col-md-5">
                <label for="q" class="form-label">Search</label>
                <input type="text" class="form-control" id="q" name="q" value="@Model.SearchQuery" placeholder="Name, phone, resident, or unit..." />
            </div>
            <div class="col-md-4">
                <label for="status" class="form-label">Status</label>
                <select class="form-select" id="status" name="status">
                    <option value="">All statuses</option>
                    <option value="Pending" selected="@(Model.StatusFilter == "Pending")">Pending</option>
                    <option value="Approved" selected="@(Model.StatusFilter == "Approved")">Approved</option>
                    <option value="CheckedIn" selected="@(Model.StatusFilter == "CheckedIn")">Checked In</option>
                    <option value="CheckedOut" selected="@(Model.StatusFilter == "CheckedOut")">Checked Out</option>
                    <option value="Declined" selected="@(Model.StatusFilter == "Declined")">Declined</option>
                    <option value="Cancelled" selected="@(Model.StatusFilter == "Cancelled")">Cancelled</option>
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-portal btn-admin w-100">Filter</button>
            </div>
        </form>

        @if (Model.Visitors.Any())
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th scope="col">Visitor</th>
                            <th scope="col">Resident</th>
                            <th scope="col">Arrival</th>
                            <th scope="col">Guests</th>
                            <th scope="col">Status</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var visitor in Model.Visitors)
                        {
                            <tr>
                                <td class="visitor-name-cell" title="@visitor.VisitorName">
                                    <a asp-area="AdminPortal" asp-controller="Visitors" asp-action="Details" asp-route-id="@visitor.Uid">
                                        @visitor.VisitorName
                                    </a>
                                    @if (visitor.IsWalkIn)
                                    {
                                        <span class="badge text-bg-info ms-1">Walk-in</span>
                                    }
                                </td>
                                <td>
                                    @visitor.ResidentName
                                    @if (!string.IsNullOrWhiteSpace(visitor.ResidentUnit))
                                    {
                                        <br /><small class="text-secondary">Unit @visitor.ResidentUnit</small>
                                    }
                                </td>
                                <td>@visitor.ArrivalDate.ToString("dd MMM yyyy", CultureInfo.InvariantCulture)</td>
                                <td>@visitor.NumberOfGuests</td>
                                <td><span class="badge @Badge(visitor.Status)">@StatusLabel(visitor.Status)</span></td>
                                <td>
                                    @if (visitor.Status == "Pending")
                                    {
                                        <form asp-area="AdminPortal" asp-controller="Visitors" asp-action="Approve" asp-route-id="@visitor.Uid" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-success">Approve</button>
                                        </form>
                                        <a asp-area="AdminPortal" asp-controller="Visitors" asp-action="Decline" asp-route-id="@visitor.Uid" class="btn btn-sm btn-outline-danger">Decline</a>
                                    }
                                    <a asp-area="AdminPortal" asp-controller="Visitors" asp-action="Details" asp-route-id="@visitor.Uid" class="btn btn-sm btn-outline-secondary">Details</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-secondary mb-0">No visitors found matching your criteria.</p>
        }
    </div>
</section>
