@model LoginViewModel
@{
    ViewData["Title"] = "Receptionist Login";
    Layout = "_ReceptionLoginLayout";
}

<div class="login-card">
    <p class="login-kicker">Reception Desk</p>
    <h1>Sign in</h1>
    <p class="login-lead">Enter your credentials to access the reception portal.</p>
    @if (Context.Request.Query.ContainsKey("sessionExpired"))
    {
        <div class="alert alert-warning" role="alert">
            <i class="bi bi-exclamation-triangle me-2" aria-hidden="true"></i>
            Your session expired, please try again.
        </div>
    }
    <form asp-area="ReceptionPortal" asp-controller="Account" asp-action="Index" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>
        <div class="mb-3">
            <label asp-for="Username" class="form-label">Username</label>
            <div class="input-icon-group">
                <i class="bi bi-person" aria-hidden="true"></i>
                <input asp-for="Username" class="form-control" autocomplete="username" autofocus />
            </div>
            <span asp-validation-for="Username" class="field-validation-error"></span>
        </div>
        <div class="mb-4">
            <label asp-for="Password" class="form-label">Password</label>
            <div class="input-icon-group has-toggle">
                <i class="bi bi-lock" aria-hidden="true"></i>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <button type="button" class="password-toggle" data-password-toggle="Password" aria-label="Show password" aria-pressed="false">
                    <i class="bi bi-eye" aria-hidden="true"></i>
                </button>
            </div>
            <span asp-validation-for="Password" class="field-validation-error"></span>
        </div>
        <button type="submit" class="btn btn-portal btn-reception w-100">Sign in</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
