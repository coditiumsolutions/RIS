@model ReceptionistDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    string Badge(string status) => status switch
    {
        "CheckedIn" => "text-bg-success",
        "CheckedOut" => "text-bg-secondary",
        "Approved" => "text-bg-primary",
        "Pending" => "text-bg-warning",
        _ => "text-bg-light"
    };
    string StatusLabel(string status) => status switch
    {
        "CheckedIn" => "Checked In",
        "CheckedOut" => "Checked Out",
        _ => status
    };
}

<div class="page-header">
    <div>
        <h1 class="page-heading">Welcome, @Model.ReceptionistName</h1>
        <p class="page-subtitle">Reception desk overview for today.</p>
    </div>
</div>

@if (TempData[ChangePasswordViewModel.SuccessMessageKey] is string passwordChanged)
{
    <div class="alert alert-success" role="status">@passwordChanged</div>
}

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <section class="card portal-card stat-card">
            <div class="card-body">
                <div class="stat-icon" aria-hidden="true"><i class="bi bi-calendar-check"></i></div>
                <p class="stat-label">Expected today</p>
                <p class="stat-value">@Model.ExpectedVisitorsToday</p>
            </div>
        </section>
    </div>
    <div class="col-md-3">
        <section class="card portal-card stat-card">
            <div class="card-body">
                <div class="stat-icon" aria-hidden="true"><i class="bi bi-box-arrow-in-right"></i></div>
                <p class="stat-label">Checked in</p>
                <p class="stat-value">@Model.CheckedInToday</p>
            </div>
        </section>
    </div>
    <div class="col-md-3">
        <section class="card portal-card stat-card">
            <div class="card-body">
                <div class="stat-icon" aria-hidden="true"><i class="bi bi-box-arrow-right"></i></div>
                <p class="stat-label">Checked out</p>
                <p class="stat-value">@Model.CheckedOutToday</p>
            </div>
        </section>
    </div>
    <div class="col-md-3">
        <section class="card portal-card stat-card">
            <div class="card-body">
                <div class="stat-icon" aria-hidden="true"><i class="bi bi-person-plus"></i></div>
                <p class="stat-label">Walk-ins today</p>
                <p class="stat-value">@Model.WalkInsToday</p>
            </div>
        </section>
    </div>
</div>

<div class="row g-4">
    <div class="col-12">
        <section class="card portal-card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h5 mb-0">Quick Actions</h2>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <a class="btn btn-portal btn-reception" asp-area="ReceptionPortal" asp-controller="Visitors" asp-action="Index">
                        <i class="bi bi-search me-1" aria-hidden="true"></i> Search Visitors
                    </a>
                    <a class="btn btn-outline-portal" asp-area="ReceptionPortal" asp-controller="Visitors" asp-action="WalkIn">
                        <i class="bi bi-person-plus me-1" aria-hidden="true"></i> Register Walk-In
                    </a>
                </div>
            </div>
        </section>
    </div>
</div>

@if (Model.RecentActivity.Any())
{
    <section class="card portal-card mt-4">
        <div class="card-body">
            <h2 class="h5 mb-3">Recent Activity</h2>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Visitor</th>
                            <th scope="col">Resident</th>
                            <th scope="col">Status</th>
                            <th scope="col">Arrival Date</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var visitor in Model.RecentActivity)
                        {
                            <tr>
                                <td class="visitor-name-cell" title="@visitor.VisitorName">
                                    @visitor.VisitorName
                                    @if (visitor.IsWalkIn)
                                    {
                                        <span class="badge text-bg-info ms-1">Walk-in</span>
                                    }
                                </td>
                                <td>
                                    @visitor.ResidentName
                                    @if (!string.IsNullOrWhiteSpace(visitor.ResidentUnit))
                                    {
                                        <span class="text-secondary">(Unit @visitor.ResidentUnit)</span>
                                    }
                                </td>
                                <td><span class="badge @Badge(visitor.Status)">@StatusLabel(visitor.Status)</span></td>
                                <td>@visitor.ArrivalDate.ToString("dd MMM yyyy", CultureInfo.InvariantCulture)</td>
                                <td>
                                    @if (visitor.Status == "Approved" || visitor.Status == "Pending")
                                    {
                                        <form asp-area="ReceptionPortal" asp-controller="Visitors" asp-action="CheckIn" asp-route-id="@visitor.Uid" method="post" enctype="multipart/form-data" class="d-inline">
                                            <input type="file" name="photo" accept="image/jpeg,image/png" hidden />
                                            <button type="submit"
                                                    class="btn btn-sm btn-success"
                                                    data-confirm-title="Check in visitor?"
                                                    data-confirm-text="@visitor.VisitorName · @visitor.NumberOfGuests guest@(visitor.NumberOfGuests == 1 ? "" : "s")"
                                                    data-confirm-ok="Check In"
                                                    data-confirm-cancel="Cancel"
                                                    data-confirm-photo="CheckIn">Check In</button>
                                        </form>
                                    }
                                    else if (visitor.Status == "CheckedIn")
                                    {
                                        <form asp-area="ReceptionPortal" asp-controller="Visitors" asp-action="CheckOut" asp-route-id="@visitor.Uid" method="post" enctype="multipart/form-data" class="d-inline">
                                            <input type="file" name="photo" accept="image/jpeg,image/png" hidden />
                                            <button type="submit"
                                                    class="btn btn-sm btn-secondary"
                                                    data-confirm-title="Check out visitor?"
                                                    data-confirm-text="@visitor.VisitorName · @visitor.NumberOfGuests guest@(visitor.NumberOfGuests == 1 ? "" : "s")"
                                                    data-confirm-ok="Check Out"
                                                    data-confirm-cancel="Cancel"
                                                    data-confirm-photo="CheckOut">Check Out</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
}
