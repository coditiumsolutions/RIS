@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    string Active(string name) =>
        string.Equals(controller, name, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
    string ActiveAction(string controllerName, string actionName) =>
        string.Equals(controller, controllerName, StringComparison.OrdinalIgnoreCase)
        && string.Equals(action, actionName, StringComparison.OrdinalIgnoreCase)
            ? "active"
            : string.Empty;
    var displayName = User.Identity?.Name ?? "Receptionist";
    var initials = string.Concat(displayName
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(part => char.ToUpperInvariant(part[0])));
    if (string.IsNullOrWhiteSpace(initials))
    {
        initials = "R";
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <partial name="_HeadAssets" />
    <title>@ViewData["Title"] - Reception Portal</title>
</head>
<body class="app-body portal-reception">
    <div class="app-frame">
        <header class="app-header-primary">
            <div class="app-header-primary-inner">
                <a class="app-brand" asp-area="ReceptionPortal" asp-controller="Dashboard" asp-action="Index">
                    <div class="brand-mark" aria-hidden="true"><i class="bi bi-person-badge-fill"></i></div>
                    <div class="app-brand-copy">
                        <strong>RIS</strong>
                        <span>Reception Portal</span>
                    </div>
                </a>
                <div class="dropdown app-user-menu">
                    <button class="dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Account menu">
                        <span class="app-avatar" aria-hidden="true">@initials</span>
                        <span class="app-user-name">@displayName</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <a class="dropdown-item" asp-area="ReceptionPortal" asp-controller="Password" asp-action="Index">
                                <i class="bi bi-key" aria-hidden="true"></i> Change Password
                            </a>
                        </li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <form asp-area="ReceptionPortal" asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="dropdown-item danger">
                                    <i class="bi bi-box-arrow-right" aria-hidden="true"></i> Logout
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <header class="app-header-secondary">
            <div class="app-header-secondary-inner">
                <button type="button" class="sidebar-toggle" data-sidebar-toggle aria-label="Toggle navigation">
                    <i class="bi bi-list" aria-hidden="true"></i>
                </button>
                <nav class="header-quick-nav d-none d-md-flex" aria-label="Quick links">
                    <a asp-area="ReceptionPortal" asp-controller="Dashboard" asp-action="Index" class="@(Active("Dashboard") == "active" ? "active" : null)">Dashboard</a>
                    <a asp-area="ReceptionPortal" asp-controller="Visitors" asp-action="Index" class="@(ActiveAction("Visitors", "Index") == "active" ? "active" : null)">Visitors</a>
                    <a asp-area="ReceptionPortal" asp-controller="Visitors" asp-action="WalkIn" class="@(ActiveAction("Visitors", "WalkIn") == "active" ? "active" : null)">Walk-In</a>
                </nav>
                <nav aria-label="Breadcrumb" class="ms-md-auto">
                    <ol class="app-breadcrumb">
                        <li><a asp-area="ReceptionPortal" asp-controller="Dashboard" asp-action="Index">Reception Portal</a></li>
                        <li><i class="bi bi-chevron-right" aria-hidden="true"></i></li>
                        <li class="current">@ViewData["Title"]</li>
                    </ol>
                </nav>
            </div>
        </header>

        <div class="app-gold-rule" aria-hidden="true"></div>

        <div class="app-shell">
            <div class="sidebar-backdrop" data-sidebar-backdrop></div>
            <aside class="app-sidebar" aria-label="Reception navigation">
                <nav class="app-sidebar-nav">
                    <a class="@Active("Dashboard")" asp-area="ReceptionPortal" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-speedometer2" aria-hidden="true"></i>
                        <span class="app-sidebar-label">Dashboard</span>
                    </a>
                    <a class="@ActiveAction("Visitors", "Index")" asp-area="ReceptionPortal" asp-controller="Visitors" asp-action="Index">
                        <i class="bi bi-people" aria-hidden="true"></i>
                        <span class="app-sidebar-label">Visitor List</span>
                    </a>
                    <a class="@ActiveAction("Visitors", "WalkIn")" asp-area="ReceptionPortal" asp-controller="Visitors" asp-action="WalkIn">
                        <i class="bi bi-person-plus" aria-hidden="true"></i>
                        <span class="app-sidebar-label">Walk-In Registration</span>
                    </a>
                    <a class="nav-link-account @Active("Password")" asp-area="ReceptionPortal" asp-controller="Password" asp-action="Index">
                        <i class="bi bi-key" aria-hidden="true"></i>
                        <span class="app-sidebar-label">Change Password</span>
                    </a>
                    <form asp-area="ReceptionPortal" asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="nav-link-btn nav-link-logout">
                            <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                            <span class="app-sidebar-label">Logout</span>
                        </button>
                    </form>
                </nav>
            </aside>

            <div class="app-content-wrap">
                <main class="app-content">
                    @RenderBody()
                </main>
                <footer class="app-footer">
                    &copy; 2026 Resident Portal Management System. All rights reserved.
                </footer>
            </div>
        </div>
    </div>

    <partial name="_Scripts" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
