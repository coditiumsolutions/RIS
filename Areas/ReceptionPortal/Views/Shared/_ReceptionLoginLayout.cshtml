<!DOCTYPE html>
<html lang="en">
<head>
    <partial name="_HeadAssets" />
    <title>@ViewData["Title"] - Reception Portal</title>
</head>
<body class="login-page reception-login-page">
    <div class="login-stage">
        <div class="login-hero">
            <div>
                <div class="login-hero-brand">
                    <div class="brand-mark" aria-hidden="true"><i class="bi bi-person-badge-fill"></i></div>
                    <div>
                        <strong>RIS</strong>
                        <span>Reception Portal</span>
                    </div>
                </div>
                <h2>Welcome to the Reception Portal</h2>
                <p>Manage visitor check-ins, check-outs, and walk-in registrations for the residential community.</p>
            </div>
            <div class="login-hero-art">
                <div class="login-hero-tile">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <span>Search</span>
                </div>
                <div class="login-hero-tile">
                    <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
                    <span>Check-In</span>
                </div>
                <div class="login-hero-tile">
                    <i class="bi bi-person-plus" aria-hidden="true"></i>
                    <span>Walk-In</span>
                </div>
            </div>
        </div>
        <div class="login-panel">
            @RenderBody()
        </div>
    </div>
    <partial name="_Scripts" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
