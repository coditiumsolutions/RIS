@model ReceptionistDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var checkInUrl = Url.Action("CheckIn", "Visitors", new { area = "Staff" })!;
    var checkOutUrl = Url.Action("CheckOut", "Visitors", new { area = "Staff" })!;
    var walkInUrl = Url.Action("WalkIn", "Visitors", new { area = "Staff" })!;
    var detailsUrl = Url.Action("Details", "Visitors", new { area = "Staff" })!;
    var searchUrl = Url.Action("Search", "Desk", new { area = "Staff" })!;
    var dayUrl = Url.Action("Day", "Desk", new { area = "Staff" })!;
    var calendarUrl = Url.Action("CalendarMonth", "Desk", new { area = "Staff" })!;
    var summaryUrl = Url.Action("Summary", "Desk", new { area = "Staff" })!;
}

@section Styles {
    <link rel="stylesheet" href="~/css/reception-dashboard.css" asp-append-version="true" />
}

<div class="rd-desk"
     id="reception-desk"
     data-today="@Model.TodayIso"
     data-search-url="@searchUrl"
     data-day-url="@dayUrl"
     data-calendar-url="@calendarUrl"
     data-summary-url="@summaryUrl"
     data-checkin-url="@checkInUrl"
     data-checkout-url="@checkOutUrl"
     data-details-url="@detailsUrl"
     data-walkin-url="@walkInUrl">

    <form id="rd-antiforgery" class="d-none" method="post">@Html.AntiForgeryToken()</form>

    <div class="rd-sticky-top">
        <div class="rd-welcome">
            <div>
                <h1 class="rd-heading">Reception Desk</h1>
                <p class="rd-sub">Hi @Model.ReceptionistName · times in PKT</p>
            </div>
            <div class="rd-quick-actions">
                <a class="rd-btn rd-btn-primary" href="@walkInUrl">
                    <i class="bi bi-person-plus" aria-hidden="true"></i>
                    New Walk-in
                </a>
                <button type="button" class="rd-btn rd-btn-secondary" data-rd-pass-code>
                    <i class="bi bi-upc-scan" aria-hidden="true"></i>
                    Pass code
                </button>
            </div>
        </div>

        @if (TempData[ChangePasswordViewModel.SuccessMessageKey] is string passwordChanged)
        {
            <div class="alert alert-success" role="status">@passwordChanged</div>
        }
        @if (TempData["Success"] is string successMsg)
        {
            <div class="alert alert-success" role="status">@successMsg</div>
        }
        @if (TempData["Error"] is string errorMsg)
        {
            <div class="alert alert-danger" role="alert">@errorMsg</div>
        }

        <label class="rd-search-label" for="rd-search">
            <span class="visually-hidden">Search visitors</span>
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search"
                   id="rd-search"
                   class="rd-search-input"
                   placeholder="Search name, CNIC, phone, vehicle, resident, unit, or pass code"
                   autocomplete="off"
                   enterkeyhint="search"
                   inputmode="search" />
            <button type="button" class="rd-search-clear" data-rd-clear-search hidden aria-label="Clear search">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
        </label>

        <div class="rd-chips" role="toolbar" aria-label="Today summary filters">
            <button type="button" class="rd-chip is-active" data-rd-filter="all" aria-pressed="true">
                <span class="rd-chip-label">All today</span>
                <span class="rd-chip-value" data-rd-summary="all">—</span>
            </button>
            <button type="button" class="rd-chip" data-rd-filter="expected" aria-pressed="false">
                <span class="rd-chip-label">Expected</span>
                <span class="rd-chip-value" data-rd-summary="expected">@Model.ExpectedVisitorsToday</span>
            </button>
            <button type="button" class="rd-chip" data-rd-filter="checkedin" aria-pressed="false">
                <span class="rd-chip-label">Inside now</span>
                <span class="rd-chip-value" data-rd-summary="checkedin">@Model.CheckedInToday</span>
            </button>
            <button type="button" class="rd-chip" data-rd-filter="checkedout" aria-pressed="false">
                <span class="rd-chip-label">Checked out</span>
                <span class="rd-chip-value" data-rd-summary="checkedout">@Model.CheckedOutToday</span>
            </button>
            <button type="button" class="rd-chip" data-rd-filter="walkins" aria-pressed="false" data-rd-walkins-chip @(Model.WalkInsToday == 0 ? "hidden" : null)>
                <span class="rd-chip-label">Walk-ins</span>
                <span class="rd-chip-value" data-rd-summary="walkins">@Model.WalkInsToday</span>
            </button>
        </div>
    </div>

    <div class="rd-layout">
        <section class="rd-calendar-panel" aria-label="Visitor calendar">
            <div class="rd-cal-toolbar">
                <button type="button" class="rd-icon-btn" data-rd-cal-prev aria-label="Previous period">
                    <i class="bi bi-chevron-left" aria-hidden="true"></i>
                </button>
                <div class="rd-cal-title" data-rd-cal-title>…</div>
                <button type="button" class="rd-icon-btn" data-rd-cal-next aria-label="Next period">
                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                </button>
                <button type="button" class="rd-btn rd-btn-ghost" data-rd-cal-today>Today</button>
            </div>
            <div class="rd-cal-weekdays" aria-hidden="true">
                <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
            </div>
            <div class="rd-cal-grid" data-rd-cal-grid role="grid" aria-label="Month calendar"></div>
            <div class="rd-cal-strip" data-rd-cal-strip hidden role="listbox" aria-label="Day strip"></div>
        </section>

        <section class="rd-list-panel" aria-label="Visitors for selected day">
            <div class="rd-list-header">
                <h2 class="rd-list-title" data-rd-list-title>Today</h2>
                <span class="rd-list-meta" data-rd-list-meta></span>
            </div>
            <div class="rd-list-status" data-rd-list-status hidden></div>
            <div class="rd-visitor-list" data-rd-visitor-list></div>
        </section>
    </div>
</div>

@section Scripts {
    <script src="~/js/reception-dashboard.js" asp-append-version="true"></script>
}
