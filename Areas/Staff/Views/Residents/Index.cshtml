@model ResidentListViewModel
@{
    ViewData["Title"] = "Resident Management";
}

<div class="page-header">
    <div>
        <h1 class="page-heading">Resident Management</h1>
        <p class="page-subtitle">Create and manage resident accounts.</p>
    </div>
    <a class="btn btn-portal btn-admin" asp-area="Staff" asp-controller="Residents" asp-action="Create">
        <i class="bi bi-person-plus me-1" aria-hidden="true"></i> Add Resident
    </a>
</div>

@if (TempData["Success"] is string successMsg)
{
    <div class="alert alert-success" role="status">@successMsg</div>
}

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card portal-card stat-card">
            <div class="card-body">
                <p class="stat-label">Total residents</p>
                <p class="stat-value">@Model.TotalCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card portal-card stat-card">
            <div class="card-body">
                <p class="stat-label">Active accounts</p>
                <p class="stat-value">@Model.ActiveCount</p>
            </div>
        </div>
    </div>
</div>

<section class="card portal-card">
    <div class="card-body">
        <form method="get" class="row g-3 mb-4">
            <div class="col-md-9">
                <label for="q" class="form-label">Search</label>
                <input type="search"
                       class="form-control portal-search-input"
                       id="q"
                       name="q"
                       value="@Model.SearchQuery"
                       placeholder="Name, Customer ID, username, unit, or mobile..."
                       enterkeyhint="search" />
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-portal btn-admin w-100">Search</button>
            </div>
        </form>

        @if (Model.Residents.Any())
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th scope="col">Name</th>
                            <th scope="col" class="col-optional-tablet">Customer ID</th>
                            <th scope="col" class="col-optional-tablet">Username</th>
                            <th scope="col">Unit</th>
                            <th scope="col" class="col-optional-tablet">Mobile</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="table-actions">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var resident in Model.Residents)
                        {
                            <tr class="@(!resident.IsActive ? "table-secondary" : "")">
                                <td>@resident.ResidentName</td>
                                <td class="col-optional-tablet">@resident.CustomerId</td>
                                <td class="col-optional-tablet">@resident.Username</td>
                                <td>
                                    @(resident.UnitNo ?? "-")
                                    @if (!string.IsNullOrWhiteSpace(resident.Tower))
                                    {
                                        <br /><small class="text-secondary">@TowerDisplay.Format(resident.Tower)</small>
                                    }
                                </td>
                                <td class="col-optional-tablet">@(resident.Mobile ?? "-")</td>
                                <td>
                                    @if (resident.IsActive)
                                    {
                                        <span class="badge text-bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td class="table-actions">
                                    <div class="table-actions-inner">
                                        <a asp-area="Staff" asp-controller="Residents" asp-action="Edit" asp-route-id="@resident.Uid"
                                           class="btn btn-sm btn-outline-primary table-action-btn" title="Edit" aria-label="Edit">
                                            <i class="bi bi-pencil" aria-hidden="true"></i>
                                            <span class="table-action-label">Edit</span>
                                        </a>
                                        <a asp-area="Staff" asp-controller="Residents" asp-action="ResetPassword" asp-route-id="@resident.Uid"
                                           class="btn btn-sm btn-outline-secondary table-action-btn" title="Reset Password" aria-label="Reset Password">
                                            <i class="bi bi-key" aria-hidden="true"></i>
                                            <span class="table-action-label">Reset Password</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-secondary mb-0">No residents found.</p>
        }
    </div>
</section>
