@model AdminConfigurationViewModel
@{
    ViewData["Title"] = "Configurations";
}

<div class="page-header">
    <div>
        <h1 class="page-heading">Configurations</h1>
        <p class="page-subtitle">SMTP, email notifications, complaint SLA, and categories.</p>
    </div>
</div>

@if (TempData["Success"] is string successMsg)
{
    <div class="alert alert-success" role="status">@successMsg</div>
}
@if (TempData["Error"] is string errorMsg)
{
    <div class="alert alert-danger" role="alert">@errorMsg</div>
}

<div class="row g-4">
    <div class="col-lg-7">
        <section class="card portal-card">
            <div class="card-body">
                <h2 class="h5 mb-3">Email &amp; SMTP</h2>
                <form asp-action="Index" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <div class="form-check mb-3">
                        <input asp-for="EmailNotificationsEnabled" class="form-check-input" />
                        <label asp-for="EmailNotificationsEnabled" class="form-check-label"></label>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label asp-for="SmtpHost" class="form-label"></label>
                            <input asp-for="SmtpHost" class="form-control" autocomplete="off" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="SmtpPort" class="form-label"></label>
                            <input asp-for="SmtpPort" class="form-control" />
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input asp-for="SmtpUseSsl" class="form-check-input" />
                                <label asp-for="SmtpUseSsl" class="form-check-label"></label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SmtpUsername" class="form-label"></label>
                            <input asp-for="SmtpUsername" class="form-control" autocomplete="off" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SmtpPassword" class="form-label"></label>
                            <input asp-for="SmtpPassword" class="form-control" autocomplete="new-password" placeholder="@(Model.HasSmtpPassword ? "Leave blank to keep existing" : "")" />
                            @if (Model.HasSmtpPassword)
                            {
                                <div class="form-text">A password is already stored.</div>
                            }
                        </div>
                        <div class="col-md-6">
                            <label asp-for="FromEmail" class="form-label"></label>
                            <input asp-for="FromEmail" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="FromName" class="form-label"></label>
                            <input asp-for="FromName" class="form-control" />
                        </div>
                    </div>

                    <h2 class="h5 mt-4 mb-3">Complaint SLA (hours)</h2>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="SlaUrgentHours" class="form-label"></label>
                            <input asp-for="SlaUrgentHours" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="SlaNormalHours" class="form-label"></label>
                            <input asp-for="SlaNormalHours" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="SlaLowHours" class="form-label"></label>
                            <input asp-for="SlaLowHours" class="form-control" />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-portal btn-admin mt-4">Save configuration</button>
                </form>

                <form asp-action="SendTestEmail" method="post" class="mt-3 border-top pt-3">
                    <label class="form-label" for="testEmail">Send test email</label>
                    <div class="input-group">
                        <input class="form-control" id="testEmail" name="testEmail" type="email" placeholder="Optional override address" />
                        <button type="submit" class="btn btn-outline-secondary"
                                data-confirm-title="Send test email?"
                                data-confirm-ok="Send">Send test</button>
                    </div>
                    <div class="form-text">Uses your admin email if left blank.</div>
                </form>
            </div>
        </section>
    </div>
    <div class="col-lg-5">
        <section class="card portal-card">
            <div class="card-body">
                <h2 class="h5 mb-3">Complaint categories</h2>
                <ul class="list-group list-group-flush mb-3">
                    @foreach (var category in Model.Categories)
                    {
                        <li class="list-group-item px-0 d-flex justify-content-between align-items-center gap-2">
                            <span class="@(!category.IsActive ? "text-secondary" : null)">
                                @category.Name
                                @if (!category.IsActive)
                                {
                                    <span class="badge text-bg-secondary">Inactive</span>
                                }
                            </span>
                            <form asp-action="ToggleCategory" asp-route-id="@category.Uid" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-secondary"
                                        data-confirm-title="@(category.IsActive ? "Deactivate category?" : "Activate category?")"
                                        data-confirm-ok="Confirm">
                                    @(category.IsActive ? "Deactivate" : "Activate")
                                </button>
                            </form>
                        </li>
                    }
                </ul>
                <form asp-action="AddCategory" method="post" class="border-top pt-3">
                    <label class="form-label" for="Name">Add category</label>
                    <div class="input-group">
                        <input class="form-control" id="Name" name="Name" maxlength="100" required />
                        <button type="submit" class="btn btn-outline-primary">Add</button>
                    </div>
                </form>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
